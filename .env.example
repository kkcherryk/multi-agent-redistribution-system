# Copy this file to .env and change what you need. Real environment variables override these values.
# Nothing here is required for running on your own computer: secrets are generated in data/.secrets.json.

# Address the services listen on. Keep 127.0.0.1 unless the app sits behind a reverse proxy.
FRS_HOST=127.0.0.1
FRS_CORE_PORT=8000
FRS_ADMIN_PORT=8001
FRS_RESTAURANT_PORT=8002
FRS_NGO_PORT=8003
FRS_LANDING_PORT=8004

# Where data (database, uploads, secrets, trained policy) is stored.
# FRS_DATA_DIR=./data
# FRS_DB_URL=sqlite:///./data/core.db

# Public addresses of the portals (set these when deployed behind HTTPS, e.g. https://ngo.example.org).
# FRS_ADMIN_URL=
# FRS_RESTAURANT_URL=
# FRS_NGO_URL=
# FRS_LANDING_URL=

# Set to 1 when the portals are served over HTTPS, so session cookies are never sent over plain HTTP.
FRS_COOKIE_SECURE=0

# Optional: provide secrets yourself instead of data/.secrets.json (use long random values).
# FRS_ADMIN_SERVICE_KEY=
# FRS_RESTAURANT_SERVICE_KEY=
# FRS_NGO_SERVICE_KEY=
# FRS_ADMIN_JWT_SECRET=
# FRS_RESTAURANT_JWT_SECRET=
# FRS_NGO_JWT_SECRET=
