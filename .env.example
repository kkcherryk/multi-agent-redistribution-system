# Copy this file to .env and change what you need. Real environment variables override these values.
# Nothing here is required for running on your own computer: secrets are generated in data/.secrets.json.

# Address the services listen on. Keep 127.0.0.1 unless the app sits behind a reverse proxy.
FRS_HOST=127.0.0.1
FRS_CORE_PORT=8000
FRS_ADMIN_PORT=8001
FRS_RESTAURANT_PORT=8002
FRS_NGO_PORT=8003
FRS_LANDING_PORT=8004

# Where data (database, uploads, secrets, trained policy) is stored.
# FRS_DATA_DIR=./data
# FRS_DB_URL=sqlite:///./data/core.db

# Public addresses of the portals (set these when deployed behind HTTPS, e.g. https://ngo.example.org).
# FRS_ADMIN_URL=
# FRS_RESTAURANT_URL=
# FRS_NGO_URL=
# FRS_LANDING_URL=

# Set to 1 when the portals are served over HTTPS, so session cookies are never sent over plain HTTP.
FRS_COOKIE_SECURE=0

# Optional: provide secrets yourself instead of data/.secrets.json (use long random values).
# FRS_ADMIN_SERVICE_KEY=
# FRS_RESTAURANT_SERVICE_KEY=
# FRS_NGO_SERVICE_KEY=
# FRS_ADMIN_JWT_SECRET=
# FRS_RESTAURANT_JWT_SECRET=
# FRS_NGO_JWT_SECRET=

# ---- Sign-in extras (all optional; see README "Google, SMS and password-reset email") ----
# Continue with Google: an OAuth client of type "Web application" from Google Cloud Console.
# FRS_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Sign in with a code by SMS: "twilio" for real texts, "console" to print codes in the terminal (testing only).
# FRS_SMS_PROVIDER=twilio
# FRS_TWILIO_ACCOUNT_SID=
# FRS_TWILIO_AUTH_TOKEN=
# FRS_TWILIO_FROM=+15551234567
# FRS_SMS_DEFAULT_COUNTRY=+91

# Forgot-password emails. Without FRS_SMTP_HOST the email (with its link) is printed in the terminal instead.
# For Gmail: smtp.gmail.com, port 587, your address, and an App password (Google Account > Security > App passwords).
# FRS_SMTP_HOST=smtp.gmail.com
# FRS_SMTP_PORT=587
# FRS_SMTP_USER=you@gmail.com
# FRS_SMTP_PASSWORD=your-16-letter-app-password
# FRS_SMTP_FROM=you@gmail.com

# Host portal: the only email address(es) allowed to sign in there (comma-separated). Every other address is refused,
# even with a correct password. Create the host account for it with: python -m scripts.create_host
# FRS_HOST_EMAILS=foodredistribution.host@gmail.com
